# Copie para .env e ajuste. Nunca versione o .env.
AMBIENTE=dev
DATABASE_URL=postgresql+psycopg://forecast:forecast_dev@localhost:5433/forecast
# Obrigatório fora de dev: gere com  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=
JWT_EXPIRACAO_MINUTOS=480
CORS_ORIGENS=["http://localhost:5173"]
# Senha dos usuários criados pelo seed (somente dev/hml)
SEED_SENHA=Forecast@2026!

# --- Login por LDAP / Active Directory ---------------------------------------------------
# Usuários comuns entram com o sAMAccountName (ex.: joao.silva). O administrador local
# continua entrando com o e-mail e a senha do banco (ex.: admin@forecast.local).
LDAP_ENABLED=false
# ldaps://host:636 (recomendado) ou ldap://host:389 com LDAP_START_TLS=true
LDAP_SERVER_URI=
LDAP_USE_SSL=false
LDAP_START_TLS=false
# false somente em testes; fora de dev a aplicação recusa subir com false
LDAP_VALIDATE_CERTIFICATES=true
# CA interna em PEM para validar o certificado do servidor (vazio = CAs do sistema)
LDAP_CA_ARQUIVO=
LDAP_TIMEOUT_SECONDS=5
# Onde buscar os usuários, ex.: DC=empresa,DC=local
LDAP_USER_BASE_DN=
# Conta de serviço (somente leitura) usada para localizar o usuário
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Opcional: bind direto com o usuário, sem conta de serviço. Ex.: {username}@empresa.local
LDAP_USER_DN_TEMPLATE=
# {username} é substituído (com escape) pelo que a pessoa digitou
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_ATTR_LOGIN=sAMAccountName
LDAP_ATTR_NOME=displayName
LDAP_ATTR_EMAIL=mail
# Perfil dado na primeira entrada (PCM, FINANCEIRO ou ADMIN). O admin ajusta depois em Usuários
LDAP_PERFIL_PADRAO=FINANCEIRO
