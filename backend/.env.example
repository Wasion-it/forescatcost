AMBIENTE=dev
DATABASE_URL=postgresql+psycopg://forecast:forecast_dev@localhost:5433/forecast
# Obrigatório fora de dev: gere com  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=
JWT_EXPIRACAO_MINUTOS=480
CORS_ORIGENS=["http://localhost:5173"]
# Senha dos usuários criados pelo seed (somente dev/hml)
SEED_SENHA=Forecast@2026!
