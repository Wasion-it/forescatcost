{
  // Requer a extensão Python Debugger (ms-python.debugpy) e o Docker em execução.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8010"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": { "AMBIENTE": "dev" },
      "jinja": true,
      "justMyCode": true,
      "preLaunchTask": "Backend: preparar banco"
    },
    {
      "name": "Frontend: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "Frontend: Vite (dev)"
    },
    {
      "name": "Testes: backend (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "justMyCode": false,
      "preLaunchTask": "Banco: subir PostgreSQL"
    },
    {
      "name": "Testes: arquivo atual (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "${file}"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "justMyCode": false,
      "preLaunchTask": "Banco: subir PostgreSQL"
    }
  ],
  "compounds": [
    {
      "name": "Aplicação completa (banco + API + frontend)",
      "configurations": ["Backend: FastAPI", "Frontend: Chrome"],
      "stopAll": true
    }
  ]
}
